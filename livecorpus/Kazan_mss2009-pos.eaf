                TIME_SLOT_REF1="ts1835" TIME_SLOT_REF2="ts1836">
                <ANNOTATION_VALUE>Ты хочешь сказать,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2301"
                TIME_SLOT_REF1="ts1837" TIME_SLOT_REF2="ts1838">
                <ANNOTATION_VALUE>что у вас в Москве, в Читай-городе,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2302"
                TIME_SLOT_REF1="ts1839" TIME_SLOT_REF2="ts1840">
                <ANNOTATION_VALUE>нет секции книг</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2303"
                TIME_SLOT_REF1="ts1841" TIME_SLOT_REF2="ts1842">
                <ANNOTATION_VALUE>на разных языках?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2304"
                TIME_SLOT_REF1="ts1843" TIME_SLOT_REF2="ts1844">
                <ANNOTATION_VALUE>Какие вот последние заходил,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2305"
                TIME_SLOT_REF1="ts1845" TIME_SLOT_REF2="ts1846">
                <ANNOTATION_VALUE>которые территориально близко</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2306"
                TIME_SLOT_REF1="ts1847" TIME_SLOT_REF2="ts1848">
                <ANNOTATION_VALUE>к мне, я не видел</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2307"
                TIME_SLOT_REF1="ts1849" TIME_SLOT_REF2="ts1850">
                <ANNOTATION_VALUE>секции на английском.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2308"
                TIME_SLOT_REF1="ts1851" TIME_SLOT_REF2="ts1852">
                <ANNOTATION_VALUE>У нас есть и на китайском,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2309"
                TIME_SLOT_REF1="ts1853" TIME_SLOT_REF2="ts1854">
                <ANNOTATION_VALUE>и на французском, и что-то немножко на турецком,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2310"
                TIME_SLOT_REF1="ts1855" TIME_SLOT_REF2="ts1856">
                <ANNOTATION_VALUE>немецком, там всякое</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2311"
                TIME_SLOT_REF1="ts1857" TIME_SLOT_REF2="ts1858">
                <ANNOTATION_VALUE>разное. Казань-пробинам тебе получается, да?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2312"
                TIME_SLOT_REF1="ts1859" TIME_SLOT_REF2="ts1860">
                <ANNOTATION_VALUE>А в восточной городе</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2313"
                TIME_SLOT_REF1="ts1861" TIME_SLOT_REF2="ts1862">
                <ANNOTATION_VALUE>или... Да, естественно, в Бачоке, в центре.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2314"
                TIME_SLOT_REF1="ts1863" TIME_SLOT_REF2="ts1864">
                <ANNOTATION_VALUE>Не, может на 106-й</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2315"
                TIME_SLOT_REF1="ts1865" TIME_SLOT_REF2="ts1866">
                <ANNOTATION_VALUE>какой-то больше в центре конкретно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2316"
                TIME_SLOT_REF1="ts1867" TIME_SLOT_REF2="ts1868">
                <ANNOTATION_VALUE>И там лучше посмотреть, да. И там может быть</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2317"
                TIME_SLOT_REF1="ts1869" TIME_SLOT_REF2="ts1870">
                <ANNOTATION_VALUE>секция на восточном, среднего размера</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2318"
                TIME_SLOT_REF1="ts1871" TIME_SLOT_REF2="ts1872">
                <ANNOTATION_VALUE>где-то вот в этой части Москвы</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2319"
                TIME_SLOT_REF1="ts1873" TIME_SLOT_REF2="ts1874">
                <ANNOTATION_VALUE>не видел.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2320"
                TIME_SLOT_REF1="ts1875" TIME_SLOT_REF2="ts1876">
                <ANNOTATION_VALUE>Нет.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2321"
                TIME_SLOT_REF1="ts1877" TIME_SLOT_REF2="ts1878">
                <ANNOTATION_VALUE>Облог, так называемый.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2322"
                TIME_SLOT_REF1="ts1879" TIME_SLOT_REF2="ts1880">
                <ANNOTATION_VALUE>Вот в Питере есть очень классный</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2323"
                TIME_SLOT_REF1="ts1881" TIME_SLOT_REF2="ts1882">
                <ANNOTATION_VALUE>буквоед, который...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2324"
                TIME_SLOT_REF1="ts1883" TIME_SLOT_REF2="ts1884">
                <ANNOTATION_VALUE>И их крестная сеть, которая</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2325"
                TIME_SLOT_REF1="ts1885" TIME_SLOT_REF2="ts1886">
                <ANNOTATION_VALUE>вместе с Читай-городе</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2326"
                TIME_SLOT_REF1="ts1887" TIME_SLOT_REF2="ts1888">
                <ANNOTATION_VALUE>как-то, не знаю,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2327"
                TIME_SLOT_REF1="ts1889" TIME_SLOT_REF2="ts1890">
                <ANNOTATION_VALUE>сотрудничать или не сотрудничать,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2328"
                TIME_SLOT_REF1="ts1891" TIME_SLOT_REF2="ts1892">
                <ANNOTATION_VALUE>или не общаться, но и</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2329"
                TIME_SLOT_REF1="ts1893" TIME_SLOT_REF2="ts1894">
                <ANNOTATION_VALUE>конторы. Там трехэтажный магазин</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2330"
                TIME_SLOT_REF1="ts1895" TIME_SLOT_REF2="ts1896">
                <ANNOTATION_VALUE>со скалатора.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2331"
                TIME_SLOT_REF1="ts1897" TIME_SLOT_REF2="ts1898">
                <ANNOTATION_VALUE>Очень-очень красиво.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2332"
                TIME_SLOT_REF1="ts1899" TIME_SLOT_REF2="ts1900">
                <ANNOTATION_VALUE>Я так не была никогда, я не слышала</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2333"
                TIME_SLOT_REF1="ts1901" TIME_SLOT_REF2="ts1902">
                <ANNOTATION_VALUE>этого.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2334"
                TIME_SLOT_REF1="ts1903" TIME_SLOT_REF2="ts1904">
                <ANNOTATION_VALUE>Я здесь в Питере, чтобы вот здесь</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2335"
                TIME_SLOT_REF1="ts1905" TIME_SLOT_REF2="ts1906">
                <ANNOTATION_VALUE>сидеть там.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2336"
                TIME_SLOT_REF1="ts1907" TIME_SLOT_REF2="ts1908">
                <ANNOTATION_VALUE>Погода, кстати, вполне себе пиццесская.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2337"
                TIME_SLOT_REF1="ts1909" TIME_SLOT_REF2="ts1910">
                <ANNOTATION_VALUE>Мне не нравится.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2338"
                TIME_SLOT_REF1="ts1911" TIME_SLOT_REF2="ts1912">
                <ANNOTATION_VALUE>Иди нафиг.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2339"
                TIME_SLOT_REF1="ts1913" TIME_SLOT_REF2="ts1914">
                <ANNOTATION_VALUE>Хорошая погода.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2340"
                TIME_SLOT_REF1="ts1915" TIME_SLOT_REF2="ts1916">
                <ANNOTATION_VALUE>Нет, с одной стороны,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2341"
                TIME_SLOT_REF1="ts1917" TIME_SLOT_REF2="ts1918">
                <ANNOTATION_VALUE>дождь как-то с зонтом, это очень забавно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2342"
                TIME_SLOT_REF1="ts1919" TIME_SLOT_REF2="ts1920">
                <ANNOTATION_VALUE>Если есть зонт, под дождем</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2343"
                TIME_SLOT_REF1="ts1921" TIME_SLOT_REF2="ts1922">
                <ANNOTATION_VALUE>ходить прикольно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2344"
                TIME_SLOT_REF1="ts1923" TIME_SLOT_REF2="ts1924">
                <ANNOTATION_VALUE>И с зонтом что-то такое.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2345"
                TIME_SLOT_REF1="ts1925" TIME_SLOT_REF2="ts1926">
                <ANNOTATION_VALUE>Но</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2346"
                TIME_SLOT_REF1="ts1927" TIME_SLOT_REF2="ts1928">
                <ANNOTATION_VALUE>без солнца мне как-то очень</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2347"
                TIME_SLOT_REF1="ts1929" TIME_SLOT_REF2="ts1930">
                <ANNOTATION_VALUE>удало и сонрило.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2348"
                TIME_SLOT_REF1="ts1931" TIME_SLOT_REF2="ts1932">
                <ANNOTATION_VALUE>Растение получается? Да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2349"
                TIME_SLOT_REF1="ts1933" TIME_SLOT_REF2="ts1934">
                <ANNOTATION_VALUE>Единственное, такое, к чему ты не любишь, когда тебя поливает.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2350"
                TIME_SLOT_REF1="ts1935" TIME_SLOT_REF2="ts1936">
                <ANNOTATION_VALUE>Какой это растение? Ты кактус!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2351"
                TIME_SLOT_REF1="ts1937" TIME_SLOT_REF2="ts1938">
                <ANNOTATION_VALUE>Все оставай понятны.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2352"
                TIME_SLOT_REF1="ts1939" TIME_SLOT_REF2="ts1940">
                <ANNOTATION_VALUE>Может сухулен? Тебе что больше нравится?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2353"
                TIME_SLOT_REF1="ts1941" TIME_SLOT_REF2="ts1942">
                <ANNOTATION_VALUE>Сухулен или кактус? Сухулен, наверное.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2354"
                TIME_SLOT_REF1="ts1943" TIME_SLOT_REF2="ts1944">
                <ANNOTATION_VALUE>У меня, думаю,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2355"
                TIME_SLOT_REF1="ts1945" TIME_SLOT_REF2="ts1946">
                <ANNOTATION_VALUE>стоит два кактуса, потому что это</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2356"
                TIME_SLOT_REF1="ts1947" TIME_SLOT_REF2="ts1948">
                <ANNOTATION_VALUE>единственное. Ну, как бы и то они там засыхают.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2357"
                TIME_SLOT_REF1="ts1949" TIME_SLOT_REF2="ts1950">
                <ANNOTATION_VALUE>Кактусы уже.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2358"
                TIME_SLOT_REF1="ts1951" TIME_SLOT_REF2="ts1952">
                <ANNOTATION_VALUE>Роллинг Стоунс,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2359"
                TIME_SLOT_REF1="ts1953" TIME_SLOT_REF2="ts1954">
                <ANNOTATION_VALUE>выключай.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2360"
                TIME_SLOT_REF1="ts1955" TIME_SLOT_REF2="ts1956">
                <ANNOTATION_VALUE>Короче, кактусы засыхают,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2361"
                TIME_SLOT_REF1="ts1957" TIME_SLOT_REF2="ts1958">
                <ANNOTATION_VALUE>потому что...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2362"
                TIME_SLOT_REF1="ts1959" TIME_SLOT_REF2="ts1960">
                <ANNOTATION_VALUE>Они там стоят,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2363"
                TIME_SLOT_REF1="ts1961" TIME_SLOT_REF2="ts1962">
                <ANNOTATION_VALUE>потому что это единственное, что кошки не едят.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2364"
                TIME_SLOT_REF1="ts1963" TIME_SLOT_REF2="ts1964">
                <ANNOTATION_VALUE>У тебя есть кошка?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
